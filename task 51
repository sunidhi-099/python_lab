ques 5 write a python program to input numbers in a list and create two separate lists for even and odd numbers
ques 5 '''
numbers = list(map(int, input("Enter numbers separated by spaces: ").split()))

even = []
odd = []

for num in numbers:
    if num % 2 == 0:
        even.append(num)
    else:
        odd.append(num)

print("Even numbers:", even)
print("Odd numbers:", odd)

