n = int(input("Enter number of tests: "))

marks = []

for i in range(n):
    mark = int(input(f"Enter marks for test {i + 1}: "))
    marks.append(mark)

# Variables for the current sequence
current_start = 0
current_length = 1

# Variables for the longest sequence
best_start = 0
best_length = 1

for i in range(1, n):

    if marks[i] > marks[i - 1]:
        current_length += 1
    else:
        current_length = 1
        current_start = i

    # Update only if a longer sequence is found
    if current_length > best_length:
        best_length = current_length
        best_start = current_start

# Get the longest sequence
longest_sequence = tuple(marks[best_start:best_start + best_length])

# Test numbers start from 1
test_range = (best_start + 1, best_start + best_length)

print("Longest improving sequence:", longest_sequence)
print("Number of tests:", best_length)
print("Test range:", test_range)
